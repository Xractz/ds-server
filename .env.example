# ds-server environment variables
#
# ds-server reads the process environment directly; it does not load
# a .env file by itself. This file is the checklist of every supported
# variable with its default. Copy the lines you need into your shell
# before starting the server, for example:
#
#   set -a; . ./.env; set +a
#   python3 ds_server.py
#
# Every variable is optional. With none of them set, the server runs
# with the defaults described below.

# Fallback DeepSeek userToken, used when a request presents no API
# key of its own. Unset by default: a request without a key gets a
# 401. Most setups leave this unset and let each client send its key.
# DS_TOKEN=

# Make the reply stored in the backend's history the answer of
# record for every request (the per-request "history_mode" body flag
# overrides this). Default: on, tuned for router and agent traffic.
# DS_HISTORY_MODE=0

# Delete a chain's backend session once the chain is replaced or
# evicted, so retired conversations do not pile up in the account's
# chat list. Default: on.
# DS_DELETE_SESSIONS=0

# Log one line per completion to stderr (model, chain outcome,
# duration, retries, status). Default: off.
# DS_LOG=1

# Request pacing. Completions are serialized and spaced to stay
# close to normal web usage. Default: on.
# DS_PACING=0

# Minimum spacing between completion starts, in seconds.
# Default: 0.4.
# DS_MIN_COMPLETION_INTERVAL=0.4

# Minimum spacing between new chat session creations, in seconds.
# Default: 1.0.
# DS_MIN_SESSION_INTERVAL=1.0

# Widen the pacing intervals automatically after a retried 429.
# Default: on.
# DS_ADAPTIVE_PACING=0

# Override the device identifier presented to the backend. Default:
# a random UUID generated once per install and stored under
# ~/.config/ds-server/.
# DS_DEVICE_ID=

# Extra debug output for upstream failures. Any value enables it.
# Default: off.
# DS_DEBUG=1
